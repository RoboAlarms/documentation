---
// A screenshot in the website's device frames: a full panel screen in the panel's bezel, a
// browser page (Panel Manager, Flasher, Home Assistant) in a browser frame, and a crop on its own.
// The size comes from the PNG itself, so a new capture needs no other change.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** small: a dialog or a crop; medium: a part of a screen. Default: the column's width. */
  size?: 'small' | 'medium';
  frame?: 'panel' | 'browser' | 'plain';
}
const { src, alt, caption, size } = Astro.props;
declare const __PUBLIC_DIR__: string; // astro.config.mjs
const png = readFileSync(join(__PUBLIC_DIR__, src));
const width = png.readUInt32BE(16);
const height = png.readUInt32BE(20);
const fullPanel = width === 1024 && height === 600;
const frame = Astro.props.frame ?? (src.startsWith('/images/panel/') ? (fullPanel ? 'panel' : 'plain') : 'browser');
---
<figure class:list={['shot', size]}>
  <a class:list={['frame', { bezel: frame === 'panel', browser: frame === 'browser', plain: frame === 'plain' }]} href={src} aria-label={`Open full-size image: ${alt}`}>
    {frame === 'browser' && <span class="browser-bar" aria-hidden="true"><i></i><i></i><i></i></span>}
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
