---
// The website's header (roboalarms.com) inside Starlight: wordmark, search, the website's
// pages, the theme picker, GitHub and "Get the Flasher".
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const site = 'https://roboalarms.com';
const links = [
  { label: 'Explore', href: `${site}/explore/` },
  { label: 'Hardware', href: `${site}/hardware/` },
  { label: 'Flasher', href: `${site}/flasher/` },
  { label: 'Updates', href: `${site}/updates/` },
];
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
    <span class="docs-badge">Docs</span>
  </div>
  <div class="sl-flex print:hidden search">
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <nav class="site-nav" aria-label="RoboAlarms website">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <ThemeSelect />
    <a class="icon-link" href="https://github.com/RoboAlarms" rel="noopener">
      <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.55v-2.14c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.09 1.77 1.19 1.77 1.19 1.03 1.76 2.71 1.25 3.37.95.1-.74.4-1.25.73-1.54-2.57-.29-5.27-1.28-5.27-5.72 0-1.26.45-2.3 1.18-3.11-.12-.29-.51-1.47.11-3.07 0 0 .97-.31 3.17 1.18a11.06 11.06 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.6.23 2.78.12 3.07.73.81 1.18 1.85 1.18 3.11 0 4.45-2.71 5.43-5.29 5.72.42.36.78 1.06.78 2.14v3.17c0 .3.21.67.8.55A11.5 11.5 0 0 0 12 .7Z"/></svg>
      <span class="sr-only">RoboAlarms on GitHub</span>
    </a>
    <a class="cta" href="https://firmware.roboalarms.com/">Get the Flasher</a>
  </div>
</div>

<style>
  @layer starlight.core {
    .header { display: flex; gap: var(--sl-nav-gap); justify-content: space-between; align-items: center; height: 100%; }
    .title-wrapper { overflow: clip; padding: .25rem; margin: -.25rem; min-width: 0; align-items: center; gap: .6rem; }
    .right-group { gap: .5rem; align-items: center; }
    @media (min-width: 50rem) {
      :global(:root[data-has-sidebar]) { --__sidebar-pad: calc(2 * var(--sl-nav-pad-x)); }
      :global(:root:not([data-has-toc])) { --__toc-width: 0rem; }
      .header {
        --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
        display: grid;
        grid-template-columns: minmax(var(--__sidebar-width), auto) minmax(10rem, 1fr) auto;
        align-content: center;
      }
    }
  }
  @layer brand {
    .title-wrapper :global(.site-title) { gap: 10px; color: var(--ra-ink); font-family: var(--ra-font-display); font-size: 1.3rem; font-weight: 700; letter-spacing: -.035em; }
    .title-wrapper :global(.site-title img) { width: 36px; height: 36px; }
    .docs-badge { padding: 2px 10px; border-radius: 999px; border: 1px solid var(--ra-accent-line); background: var(--ra-accent-soft); color: var(--ra-accent); font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
    .search { max-width: 26rem; }
    .site-nav { display: none; gap: 2px; }
    .site-nav a { padding: 8px 11px; border-radius: 10px; color: var(--ra-ink-2); font-size: .9375rem; text-decoration: none; white-space: nowrap; }
    .site-nav a:hover { color: var(--ra-ink); background: var(--ra-accent-soft); }
    .icon-link { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; border: 1px solid var(--ra-line); color: var(--ra-ink-2); }
    .icon-link:hover { color: var(--ra-ink); border-color: var(--ra-line-strong); background: var(--ra-accent-soft); }
    .cta { display: none; align-items: center; min-height: 40px; padding: 0 16px; border-radius: 999px; background: var(--ra-accent-strong); color: var(--ra-accent-ink); font-size: .9375rem; font-weight: 600; text-decoration: none; white-space: nowrap; box-shadow: 0 10px 30px -12px var(--ra-glow), inset 0 1px 0 #ffffff33; }
    .cta:hover { transform: translateY(-1px); }
    @media (min-width: 72rem) { .cta { display: inline-flex; } }
    @media (min-width: 88rem) { .site-nav { display: flex; } }
  }
</style>
